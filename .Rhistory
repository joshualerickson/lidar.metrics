window_func = function(x) {
w <- pmax(x, 1)
w <- log1p(w) * 1.5 + 2
w <- pmin(w, 6)
if (any(w <= 0 | is.na(w))) {
w[is.na(w) | w <= 0] <- 3  # fallback default
}
return(w)
}
