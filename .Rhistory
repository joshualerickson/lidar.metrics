out <- matrix(NA_real_, nrow = nrow(newdata), ncol = length(lv))
if (any(keep)) {
p <- predict(gbm_model,
newdata = newdata[keep, , drop = FALSE],
n.trees = gbm_model$n.trees,
type = "response")
p <- as.matrix(p)
if (ncol(p) == length(lv)) {
out[keep, ] <- p                                  # multinomial
} else if (ncol(p) == 1L && length(lv) == 2L) {
out[keep, 2] <- p                                 # binary: prob of positive
out[keep, 1] <- 1 - p
} else {
stop("Unexpected predict.gbm shape: ", ncol(p), " cols for ", length(lv), " classes")
}
}
df <- as.data.frame(out)
names(df) <- paste0("prob_", lv)
df
}
# 3) Predict to probability layers (one band per class)
prob_rast <- terra::predict(
mod_crop,
mod$finalModel,
fun      = gbm_fun_prob,
cores    = 2,
na.rm    = FALSE,  # <-- keep FALSE; wrapper handles NAs
filename = "gbm_probs.tif",
overwrite = TRUE,
wopt = list(datatype = "FLT4S", names = paste0("prob_", lv), gdal = "COMPRESS=LZW")
)
pred_fun_prob <- function(model, newdata) {
lv <- model$levels
keep <- stats::complete.cases(newdata)
# pre-allocate full output (same nrow as input chunk)
out <- matrix(NA_real_, nrow = nrow(newdata), ncol = length(lv))
colnames(out) <- lv
if (any(keep)) {
p <- predict(model, newdata = newdata[keep, , drop = FALSE], type = "prob")
# ensure column order matches model$levels
p <- as.matrix(p[, lv, drop = FALSE])
out[keep, ] <- p
}
df <- as.data.frame(out)
names(df) <- paste0("prob_", lv)
df
}
