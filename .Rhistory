wf <- function(x) {
x <- pmax(x, 1e-3)  # avoid log(0) or small values
ws <- log1p(x) * 1.5 + 2
ws <- pmin(pmax(ws, 2), 6)  # constrain to [2, 6]
return(ws)
}
